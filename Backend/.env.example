PORT=5000
NODE_ENV=development

# URL du frontend (plusieurs origines possibles, séparées par des virgules)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI="mongodb+srv://cluster0.xxxxx.mongodb.net/"
MONGODB_DBNAME=dar-el-bahdja
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Secret JWT : longue chaîne aléatoire (obligatoire en production)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Compte super admin créé par `npm run seed`
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Photos : Cloudinary (https://cloudinary.com → Dashboard → "API Keys").
# Laisser vide en développement : les photos sont alors écrites dans le dossier uploads.
# OBLIGATOIRE en production (le disque des hébergeurs gratuits est effacé à chaque redémarrage).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
